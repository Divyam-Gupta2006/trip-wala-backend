PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:secretpassword@localhost:5432/trip_wala?schema=public"

# Cache Configuration (Redis)
REDIS_URL="redis://localhost:6379/0"

# JWT Config (Generate long secure keys in production)
JWT_SECRET="dev_jwt_access_token_secret_key_12345"
JWT_REFRESH_SECRET="dev_jwt_refresh_token_secret_key_12345"

# Security Configuration
CORS_ORIGIN="http://localhost:3000"
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX=100
